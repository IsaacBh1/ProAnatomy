NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Neon gives you two connection strings for the same branch. Use BOTH.
#
#   DATABASE_URL — the *pooled* one. Hostname contains `-pooler`. The app runs
#                  through PgBouncer, which is what keeps a serverless-ish
#                  workload from exhausting Postgres connection slots.
#
#   DIRECT_URL   — the *direct* one. Same hostname, without `-pooler`.
#                  Prisma Migrate uses this because the pooler does not
#                  support the session-scoped advisory locks migrations take.
#
# Locally with docker-compose, both point at the same container.

DATABASE_URL="postgresql://anatomist:anatomist_dev_pw@localhost:5433/pro_anatomy?schema=public"
DIRECT_URL="postgresql://anatomist:anatomist_dev_pw@localhost:5433/pro_anatomy?schema=public"

# On Neon:
# DATABASE_URL="postgresql://…@ep-xxx-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://…@ep-xxx.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME_dev_only_at_least_32_chars_long_AAAAAAAAA"
REFRESH_TOKEN_PEPPER="CHANGE_ME_dev_only_at_least_32_chars_long_BBBBBBBBB"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. No wildcards — credentials are enabled, so "*" is refused
# at startup. Add every origin the frontend is served from, including preview
# deploys if you want them to work (e.g. a regex-less explicit list).
CORS_ORIGINS=http://localhost:5173

# ── Cookies ──────────────────────────────────────────────────────────────────
# Leave COOKIE_DOMAIN empty unless the frontend and API share a parent domain.
# Vercel (vercel.app) and Render (onrender.com) do NOT — leave this blank.
COOKIE_DOMAIN=

# 'strict' locally. Use 'none' in production when the frontend and API are on
# different registrable domains (the Vercel + Render case). Requires HTTPS.
COOKIE_SAME_SITE=strict

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set to 1 behind exactly one reverse proxy (Render sets X-Forwarded-For and
# terminates TLS, so this should be 1 there). Leaving it 0 behind a proxy
# means req.ip is the proxy, and every user shares one rate-limit bucket.
TRUST_PROXY=0

# Off by default in production. Set to 1 to serve /api/docs there too — only
# do that if the API is not publicly reachable.
# ENABLE_DOCS=0
